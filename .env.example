# ===== GITHUB MODELS API =====
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
GITHUB_MODEL=gpt-4o-mini

# ===== LLM PARAMETERS =====
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=20
ANALYSIS_TIMEOUT_SECONDS=75
HEALTH_CHECK_TIMEOUT_SECONDS=2

# ===== DATABASE =====
POSTGRES_USER=agentic_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=logistics_app
DATABASE_URL=postgresql+asyncpg://agentic_user:change_me_strong_password@db:5432/logistics_app

# ===== REDIS =====
REDIS_URL=redis://redis:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== API SECURITY =====
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=generate_a_strong_api_key_here

# ===== PORTFOLIO PAGE =====
PORTFOLIO_PASSWORD=your_portfolio_password_here

# ===== ENVIRONMENT =====
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=*

PYTHONUNBUFFERED=1

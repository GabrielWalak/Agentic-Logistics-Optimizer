# Environment variables for Agentic Logistics API
# Copy this file to .env and fill in your actual values

# === DATABASE ===
POSTGRES_USER=agentic_user
POSTGRES_PASSWORD=agentic_password_change_me
POSTGRES_DB=logistics_app
DATABASE_URL=postgresql+asyncpg://agentic_user:agentic_password_change_me@db:5432/logistics_app

# === REDIS ===
REDIS_URL=redis://redis:6379/0

# === GITHUB MODELS API ===
GITHUB_TOKEN=your_github_token_here
GITHUB_MODEL=gpt-4o-mini

# === API SECURITY ===
# IMPORTANT: Generate a strong API key and keep it secret!
# Example: openssl rand -hex 32
# Never commit the actual value to git - use .gitignore
API_KEY=your_secret_api_key_change_this_in_production

# === ENVIRONMENT ===
ENVIRONMENT=development
LOG_LEVEL=info
LLM_PROVIDER=github

# === AWS (Optional - for future Bedrock integration) ===
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === CORS ===
CORS_ORIGINS=*
